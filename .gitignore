# Local credentials; only empty configuration templates may be committed.
.env
.env.*
!.env.example
*_api_key.txt
*tokens.yaml
*.pem
*.key
/private/

# Local Python environments and generated files.
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.log
.vscode/
.idea/
.DS_Store

# Session 3 generated run files; keep only the empty directory markers.
practices/session-03/exercise-a/run-results/*
!practices/session-03/exercise-a/run-results/.gitkeep
practices/session-03/exercise-b/run-results/*
!practices/session-03/exercise-b/run-results/.gitkeep
